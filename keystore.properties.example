# Quiddity Android 发布签名配置（示例）
#
# 使用方法：
#   1. 复制本文件为 keystore.properties：cp keystore.properties.example keystore.properties
#   2. 填入真实的签名信息（见 D:\Quiddity-Keys\android\）
#   3. 切勿提交 keystore.properties 到 Git
#
# 字段说明：
#   storeFile    : .keystore 或 .jks 文件路径（绝对路径，相对项目根亦可）
#   storePassword: keystore 密码
#   keyAlias     : 密钥别名
#   keyPassword  : 密钥密码
#
# CI/CD 中推荐通过环境变量注入：
#   QUIDDITY_STORE_FILE / QUIDDITY_STORE_PASSWORD / QUIDDITY_KEY_ALIAS / QUIDDITY_KEY_PASSWORD

storeFile=D:/Quiddity-Keys/android/release.keystore
storePassword=YOUR_STORE_PASSWORD
keyAlias=YOUR_KEY_ALIAS
keyPassword=YOUR_KEY_PASSWORD
