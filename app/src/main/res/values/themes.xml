<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- 启动屏主题（避免冷启动白屏） -->
    <style name="Theme.Quiddity.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/cream_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_icon</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/cream_bg</item>
        <item name="postSplashScreenTheme">@style/Theme.Quiddity</item>
    </style>

    <!-- 主应用主题 -->
    <style name="Theme.Quiddity" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/cream_bg</item>
        <item name="android:statusBarColor">@color/cream_bg</item>
        <item name="android:navigationBarColor">@color/cream_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <!-- 暗色主题 -->
    <style name="Theme.Quiddity.Dark" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/dark_bg</item>
        <item name="android:statusBarColor">@color/dark_bg</item>
        <item name="android:navigationBarColor">@color/dark_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>
</resources>
