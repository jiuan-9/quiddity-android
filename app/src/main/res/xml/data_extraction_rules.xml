<?xml version="1.0" encoding="utf-8"?>

<!--
  纯本地定位：应用数据仅保存在本机，不参与系统云备份 / 换机迁移。
  数据迁移统一走应用内「数据导出 / 导入」功能（SAF 文件）。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
