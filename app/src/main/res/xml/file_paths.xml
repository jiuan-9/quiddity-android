<?xml version="1.0" encoding="utf-8"?>
<!-- FileProvider 路径声明：每个子目录都需要在此注册，否则
     FileProvider.getUriForFile() 会抛 IllegalArgumentException。 -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <files-path name="quiddity_data" path="quiddity-data/" />
    <files-path name="cache" path="cache/" />
    <files-path name="wallpapers" path="wallpapers/" />
    <files-path name="avatars" path="avatars/" />
    <files-path name="list_wallpapers" path="list_wallpapers/" />
    <external-files-path name="external_files" path="." />
</paths>
